{
  "schema": "streamvibe-harness-genome",
  "nodes": [
    {
      "node_id": "event_normalizer",
      "kind": "event_normalization",
      "implementation": "harness.perception:CurrentEvidenceTracker",
      "inputs": [
        "frames",
        "environment_events",
        "request_state"
      ],
      "outputs": [
        "normalized_events"
      ],
      "state_schema": {},
      "config": {}
    },
    {
      "node_id": "video_memory",
      "kind": "video_memory",
      "implementation": "harness.memory:ThreeTierMemory",
      "inputs": [
        "normalized_events",
        "frames"
      ],
      "outputs": [
        "video_memory"
      ],
      "state_schema": {
        "recent": "ordered facts",
        "mid": "stage summaries",
        "long": "stable facts"
      },
      "config": {}
    },
    {
      "node_id": "request_state",
      "kind": "request_state",
      "implementation": "harness.criteria:CriterionSet",
      "inputs": [
        "user_events"
      ],
      "outputs": [
        "request_state"
      ],
      "state_schema": {
        "active": "criteria",
        "retired": "criteria",
        "questions": "pending questions",
        "said": "receipts"
      },
      "config": {}
    },
    {
      "node_id": "procedure_state",
      "kind": "procedure_state",
      "implementation": "harness.planning:ProceduralPlanMemory",
      "inputs": [
        "normalized_events",
        "request_state"
      ],
      "outputs": [
        "procedure_state"
      ],
      "state_schema": {
        "done": "observed steps",
        "current": "step",
        "next": "candidate step",
        "blocked": "reason"
      },
      "config": {}
    },
    {
      "node_id": "skill_retriever",
      "kind": "skill_recall",
      "implementation": "harness.experience:ExperienceStore",
      "inputs": [
        "video_memory",
        "request_state",
        "procedure_state"
      ],
      "outputs": [
        "experience"
      ],
      "state_schema": {},
      "config": {}
    },
    {
      "node_id": "canonical_state",
      "kind": "evidence_linking",
      "implementation": "harness.state_runtime:StateRuntime",
      "inputs": [
        "user_events",
        "normalized_events",
        "committed_deliveries"
      ],
      "outputs": [
        "current_state",
        "typed_deltas"
      ],
      "state_schema": {
        "request": "active obligations and pending question",
        "procedure": "visually observed progress",
        "events": "evidence-bound event instances",
        "deliveries": "committed response receipts",
        "uncertainty": "unresolved fields"
      },
      "config": {
        "single_writer": true,
        "append_only_events": true,
        "compact_projection": true,
        "max_evidence_facts": 1
      }
    },
    {
      "node_id": "state_adapter",
      "kind": "state_adapter",
      "implementation": "harness.adapter:HarnessAdapter",
      "inputs": [
        "current_state",
        "video_memory",
        "experience"
      ],
      "outputs": [
        "harness_state",
        "deltas"
      ],
      "state_schema": {},
      "config": {
        "response_history": "selective_latest_full",
        "silence_history": "first_per_epoch"
      }
    },
    {
      "node_id": "context_compiler",
      "kind": "context_compilation",
      "implementation": "harness.context:build_harness_messages",
      "inputs": [
        "harness_state",
        "deltas",
        "frames"
      ],
      "outputs": [
        "model_context"
      ],
      "state_schema": {},
      "config": {}
    }
  ],
  "edges": [
    {
      "source": "event_normalizer",
      "target": "video_memory",
      "channel": "normalized_events"
    },
    {
      "source": "event_normalizer",
      "target": "procedure_state",
      "channel": "normalized_events"
    },
    {
      "source": "request_state",
      "target": "procedure_state",
      "channel": "request_state"
    },
    {
      "source": "video_memory",
      "target": "skill_retriever",
      "channel": "video_memory"
    },
    {
      "source": "request_state",
      "target": "skill_retriever",
      "channel": "request_state"
    },
    {
      "source": "procedure_state",
      "target": "skill_retriever",
      "channel": "procedure_state"
    },
    {
      "source": "request_state",
      "target": "canonical_state",
      "channel": "user_events"
    },
    {
      "source": "event_normalizer",
      "target": "canonical_state",
      "channel": "normalized_events"
    },
    {
      "source": "canonical_state",
      "target": "state_adapter",
      "channel": "current_state"
    },
    {
      "source": "video_memory",
      "target": "state_adapter",
      "channel": "video_memory"
    },
    {
      "source": "skill_retriever",
      "target": "state_adapter",
      "channel": "experience"
    },
    {
      "source": "state_adapter",
      "target": "context_compiler",
      "channel": "harness_state"
    }
  ],
  "contracts": {
    "decision_owner": "StreamVibe-VL",
    "mutation_boundary": "between_episodes",
    "postdecision_filter": false,
    "output_rewrite": false,
    "future_or_gold_access": false,
    "epoch_header_mutation": false
  },
  "provenance": {
    "method": "StreamVibe Harness",
    "dataset_runtime_routing": false
  },
  "name": "StreamVibe Harness"
}
